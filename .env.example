# Copie este arquivo para ".env" e ajuste os valores.
# O .env NÃO vai para o GitHub (está no .gitignore): é nele que,
# mais adiante, ficarão a senha do banco e as chaves secretas.

# Porta em que a API roda no seu computador
PORTA=3000

# Sites que podem conversar com a API, separados por vírgula
ORIGENS_PERMITIDAS=http://localhost:5173,https://thepaulojorge.github.io

# Banco de dados (Neon): no painel do projeto, botão "Connect".
# DATABASE_URL: com "Connection pooling" LIGADO (o endereço tem "-pooler")
# DIRECT_URL:   com "Connection pooling" DESLIGADO (sem "-pooler")
DATABASE_URL="postgresql://usuario:senha@endereco-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@endereco.us-east-1.aws.neon.tech/neondb?sslmode=require"

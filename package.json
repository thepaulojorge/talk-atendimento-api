{
  "name": "talk-atendimento-api",
  "version": "0.1.0",
  "description": "Servidor (API) do Talk Atendimento",
  "private": true,
  "type": "module",
  "main": "src/servidor.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/servidor.js",
    "start": "node src/servidor.js",
    "postinstall": "prisma generate",
    "banco:gerar": "prisma generate",
    "banco:migrar": "prisma migrate dev",
    "banco:popular": "prisma db seed",
    "banco:ver": "prisma studio",
    "banco:aplicar": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.10.1"
  }
}
